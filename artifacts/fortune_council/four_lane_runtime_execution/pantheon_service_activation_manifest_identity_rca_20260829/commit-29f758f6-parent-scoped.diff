+def _write_normal_stage_plists(
+    stage_dir: Path,
+    *,
+    manifest: dict[str, object],
+    manifest_path: Path,
+    barrier: Path,
+    python: Path,
+    exact_run_id: str,
+) -> None:
+    stage_dir.mkdir(parents=True, exist_ok=True)
+    (stage_dir / "manifest-digest").write_text(
+        str(manifest["manifest_digest"]) + "\n",
+        encoding="utf-8",
+    )
