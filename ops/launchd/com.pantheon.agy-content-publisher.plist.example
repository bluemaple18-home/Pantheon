<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pantheon.agy-content-publisher</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>scripts.pantheon_content_runtime_manifest</string>
    <string>barrier-exec</string>
    <string>--barrier</string>
    <string>__ACTIVATION_BARRIER__</string>
    <string>--expected-digest</string>
    <string>__RUNTIME_MANIFEST_DIGEST__</string>
    <string>--manifest</string>
    <string>__RUNTIME_MANIFEST__</string>
    <string>--service-label</string>
    <string>com.pantheon.agy-content-publisher</string>
    <string>--ready-root</string>
    <string>__READY_ROOT__</string>
    <string>--timeout</string>
    <string>90</string>
    <string>--</string>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>scripts.agy_content_publisher</string>
    <string>--repo-root</string>
    <string>__REPO_ROOT__</string>
    <string>--queue-root</string>
    <string>__QUEUE_ROOT__</string>
    <string>--state-root</string>
    <string>__REPO_ROOT__/.work/content-publisher</string>
    <string>--max-runs</string>
    <string>__MAX_RUNS__</string>
    <string>--include-rewrites</string>
    <string>--push</string>
    <string>--expected-repo-root</string>
    <string>__REPO_ROOT__</string>
    <string>--expected-queue-root</string>
    <string>__QUEUE_ROOT__</string>
    <string>--expected-state-root</string>
    <string>__REPO_ROOT__/.work/content-publisher</string>
    <string>--expected-runtime-sha</string>
    <string>__RUNTIME_SHA__</string>
    <string>--expected-runtime-digest</string>
    <string>__RUNTIME_DIGEST__</string>
    <string>--expected-push-mode</string>
    <string>push</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>PANTHEON_PUBLISHER_STDOUT_LOG</key>
    <string>__STDOUT_LOG__</string>
    <key>PANTHEON_PUBLISHER_STDERR_LOG</key>
    <string>__STDERR_LOG__</string>
    <key>PANTHEON_RUNTIME_MANIFEST_DIGEST</key>
    <string>__RUNTIME_MANIFEST_DIGEST__</string>
    <key>PANTHEON_FORMAL_RUNTIME</key>
    <string>1</string>
    <key>PANTHEON_RUNTIME_MANIFEST</key>
    <string>__RUNTIME_MANIFEST__</string>
    <key>PANTHEON_RUNTIME_SERVICE_LABEL</key>
    <string>com.pantheon.agy-content-publisher</string>
    <key>PANTHEON_RUNTIME_IDENTITY_DIGEST</key>
    <string>__RUNTIME_IDENTITY_DIGEST__</string>
    <key>PANTHEON_RUNTIME_CODE_DIGEST</key>
    <string>__RUNTIME_CODE_DIGEST__</string>
    <key>PANTHEON_RUNTIME_CONFIG_VERSION</key>
    <string>__RUNTIME_CONFIG_VERSION__</string>
    <key>PANTHEON_RUNTIME_GENERATION</key>
    <string>__RUNTIME_GENERATION__</string>
        <key>PANTHEON_RUNTIME_IDENTITY</key>
        <string>__RUNTIME_IDENTITY__</string>
        <key>PANTHEON_RUNTIME_ACTOR_ROOT</key>
        <string>__REPO_ROOT__</string>
        <key>PANTHEON_RUNTIME_QUEUE_ROOT</key>
        <string>__QUEUE_ROOT__</string>
        <key>PANTHEON_RUNTIME_PUBLISHER_STATE_ROOT</key>
        <string>__PUBLISHER_STATE_ROOT__</string>
        <key>PANTHEON_RUNTIME_LOG_ROOT</key>
        <string>__LOG_ROOT__</string>
  </dict>

  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/agy-content-publisher.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/agy-content-publisher.stderr.log</string>
</dict>
</plist>
