<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pantheon.agy-gemini-coordinator</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>scripts.pantheon_content_runtime_manifest</string>
    <string>barrier-exec</string>
        <string>--barrier</string>
        <string>__ACTIVATION_BARRIER__</string>
        <string>--expected-digest</string>
        <string>__RUNTIME_MANIFEST_DIGEST__</string>
        <string>--timeout</string>
    <string>90</string>
    <string>--</string>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>scripts.agy_gemini_coordinator</string>
    <string>--queue-root</string>
    <string>__REPO_ROOT__/.work/gemini-runner</string>
    <string>--repo-root</string>
    <string>__REPO_ROOT__</string>
    <string>--new-matrix-run-root</string>
    <string>__REPO_ROOT__/.work/gsc-copy</string>
    <string>--new-matrix-sweep</string>
    <string>--legacy-state-root</string>
    <string>__REPO_ROOT__/.work/content-publisher</string>
    <string>--legacy-run-root</string>
    <string>__REPO_ROOT__/.work/gsc-copy</string>
    <string>--legacy-sweep</string>
    <string>--lane-mode</string>
    <string>cycle</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>AGY_GEMINI_CLI</key>
    <string>__AGY_GEMINI_CLI__</string>
    <key>AGY_GEMINI_NEW_ONLY</key>
    <string>0</string>
    <key>AGY_GEMINI_RATE_LIMIT_COOLDOWN_SECONDS</key>
    <string>300</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PANTHEON_RUNTIME_MANIFEST_DIGEST</key>
    <string>__RUNTIME_MANIFEST_DIGEST__</string>
        <key>PANTHEON_RUNTIME_IDENTITY</key>
        <string>__RUNTIME_IDENTITY__</string>
        <key>PANTHEON_RUNTIME_ACTOR_ROOT</key>
        <string>__REPO_ROOT__</string>
        <key>PANTHEON_RUNTIME_QUEUE_ROOT</key>
        <string>__QUEUE_ROOT__</string>
        <key>PANTHEON_RUNTIME_PUBLISHER_STATE_ROOT</key>
        <string>__PUBLISHER_STATE_ROOT__</string>
        <key>PANTHEON_RUNTIME_LOG_ROOT</key>
        <string>__LOG_ROOT__</string>
  </dict>

  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/agy-gemini-coordinator.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/agy-gemini-coordinator.stderr.log</string>
</dict>
</plist>
