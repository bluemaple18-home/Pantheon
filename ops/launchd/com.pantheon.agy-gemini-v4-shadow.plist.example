<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pantheon.agy-gemini-v4-shadow</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>scripts.agy_gemini_v4_shadow</string>
    <string>--state-root</string>
    <string>__STATE_ROOT__</string>
    <string>run-once</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>AGY_GEMINI_V4_BROKER</key>
    <string>1</string>
    <key>AGY_GEMINI_V4_CREDENTIAL_POOL_FILE</key>
    <string>__CREDENTIAL_POOL_FILE__</string>
    <key>AGY_GEMINI_V4_EXECUTABLE</key>
    <string>__STRUCTURED_TARGET__</string>
    <key>AGY_GEMINI_V4_EXECUTABLE_SHA256</key>
    <string>__STRUCTURED_TARGET_SHA256__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartInterval</key>
  <integer>21600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>__STDOUT_LOG__</string>
  <key>StandardErrorPath</key>
  <string>__STDERR_LOG__</string>
</dict>
</plist>
